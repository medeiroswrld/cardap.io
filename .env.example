NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: only needed to sync legacy Cloudflare videos. New uploads use Supabase.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_STREAM_API_TOKEN=
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Demo routes are always explicitly isolated from production routes.
# Never expose the service role or Cloudflare token with NEXT_PUBLIC_.
# Structured server logs: info | warn | error | fatal (default: info).
LOG_LEVEL=info
# Optional dedicated random secret (32+ characters). Without it, userId is omitted.
# Never reuse Supabase/Cloudflare keys; never prefix this with NEXT_PUBLIC_.
LOG_HASH_KEY=
# Dedicated random server secret (32+ chars) for rate-limit identities; never log IPs.
RATE_LIMIT_HASH_KEY=
